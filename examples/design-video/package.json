{
  "name": "magic-hour-design-video-integrations",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "framer",
    "adobe-express",
    "canva"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node build.mjs",
    "test": "tsx --test test/*.test.ts",
    "test:ui": "node test/browser.mjs",
    "dev:framer": "vite --config framer/vite.config.ts",
    "dev:adobe": "node serve.mjs adobe-express",
    "dev:canva": "node serve.mjs canva"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vite": "8.0.16",
    "vite-plugin-framer": "1.1.1"
  }
}
