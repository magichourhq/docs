{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node20",
    "moduleResolution": "Node16",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "../dist/scripts",
    "rootDir": "."
  },
  "include": ["./**/*.ts"],
  "exclude": ["../node_modules"]
}
